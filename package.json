{
  "name": "wb-cursor-bridge",
  "version": "0.6.0",
  "description": "MCP bridge that exposes the Cursor CLI as a governed sub-agent to WorkBuddy.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "wb-cursor-bridge": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('release',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pretest": "npm run build",
    "test": "node --test test/unit.test.mjs test/e2e.test.mjs test/admin.test.mjs test/a2a.test.mjs test/a2a-v1.test.mjs test/actions-dual-surface.test.mjs test/p2-structured.test.mjs test/p3-idempotency.test.mjs test/card-scan.test.mjs test/push-v1.test.mjs test/hardening.test.mjs test/audit-b0.test.mjs test/audit-b1.test.mjs test/audit-b2.test.mjs",
    "test:unit": "node --test test/unit.test.mjs",
    "test:e2e": "node --test test/e2e.test.mjs",
    "test:admin": "node --test test/admin.test.mjs",
    "test:a2a": "node --test test/a2a.test.mjs",
    "test:a2a-v1": "node --test test/a2a-v1.test.mjs",
    "test:actions": "node --test test/actions-dual-surface.test.mjs",
    "test:p2": "node --test test/p2-structured.test.mjs",
    "test:p3": "node --test test/p3-idempotency.test.mjs",
    "pretest:tck": "npm run build",
    "test:tck": "node scripts/tck.mjs",
    "test:card-scan": "node --test test/card-scan.test.mjs",
    "test:push-v1": "node --test test/push-v1.test.mjs",
    "scan:card": "npm run build && node scripts/scan-card.mjs",
    "poc:mcp-tasks": "node scripts/poc-mcp-tasks.mjs",
    "poc:a2a-grpc": "node scripts/poc-a2a-grpc.mjs",
    "test:hardening": "node --test test/hardening.test.mjs",
    "test:stress": "node --test test/stress.test.mjs",
    "test:fault": "node --test test/fault.test.mjs",
    "verify:e2e": "node scripts/e2e-empirical.mjs",
    "build:release": "npm run build && node scripts/build-release.mjs",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "verify": "node scripts/verify.mjs",
    "verify:serial": "npm run lint && npm run typecheck && npm test && npm run test:stress && npm run test:fault && npm run build:release",
    "test:audit": "node --test test/audit-*.test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "a2a",
    "agent2agent",
    "agent",
    "cursor",
    "codebuddy",
    "workbuddy",
    "bridge"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.2",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.2"
  }
}
